[gd_scene format=3 uid="uid://dxfo8p6a88klw"]

[sub_resource type="GDScript" id="GDScript_uuwdf"]
script/source = "extends Area2D

func _process(_delta):
	var elana = get_tree().get_first_node_in_group(\"player\")
	if elana == null or not (\"on_slippery_tile\" in elana):
		return
	var inside = false
	for body in get_overlapping_bodies():
		if body == elana:
			inside = true
			break
	elana.on_slippery_tile = inside
"

